    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "taxon_groups": {"type": "array", "items": {"type": "string"}, "maxItems": 10},
    "reason": {"type": "string"},
    "borderline": {"type": "string", "enum": ["none", "register_compilation", "catch_sampling", "biota_contaminants", "other"]}
  }
}
