{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andersfi/biodiversity-data-rescue/schemas/goldset_row.json",
  "title": "Gold-set row",
  "description": "One survey in goldset/goldset.csv. Columns and allowed values from docs/design.md, section 'Gold set'. expected_status refers to the pilot taxa (EPT).",
  "x-schema-version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["survey_ref", "title", "institution", "taxon_group", "region", "period",
               "method", "documents", "expected_status", "where_data_are",
               "is_borderline", "include", "found_via", "notes"],
  "properties": {
    "survey_ref":      {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title":           {"type": "string", "minLength": 1},
    "institution":     {"type": "string", "minLength": 1},
    "taxon_group":     {"type": "string", "minLength": 1},
    "region":          {"type": "string", "minLength": 1},
    "period":          {"type": "string", "minLength": 1,
                        "description": "Year, year range (YYYY–YYYY) or free text with '?' when uncertain."},
    "method":          {"type": "string"},
    "documents":       {"type": "string", "description": "DOIs, handles, NVA ids or citations, ';'-separated."},
    "expected_status": {"enum": ["in_gbif", "in_gbif_no_effort", "partly_in_gbif",
                                 "open_elsewhere", "exists_not_available", "unidentified",
                                 "not_applicable", "todo"]},
    "where_data_are":  {"type": "string"},
    "is_borderline":   {"enum": ["yes", "no"]},
    "include":         {"enum": ["yes", "no", "candidate"]},
    "found_via":       {"enum": ["anders", "kommune_page", "gbif_baseline", "reference_list",
                                 "nva_targeted", "nva_search"]},
    "notes":           {"type": "string"}
  },
  "allOf": [
    {
      "description": "'todo' is a provisional status, allowed only on unverified candidate rows (proposed 2026-11-18, awaiting Anders).",
      "if":   {"properties": {"expected_status": {"const": "todo"}}},
      "then": {"properties": {"include": {"const": "candidate"}}}
    },
    {
      "description": "Negative cases: not_applicable goes with include = no.",
      "if":   {"properties": {"expected_status": {"const": "not_applicable"}}},
      "then": {"properties": {"include": {"const": "no"}}}
    }
  ]
}
