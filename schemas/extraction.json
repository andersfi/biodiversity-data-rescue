{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andersfi/biodiversity-data-rescue/schemas/extraction.json",
  "title": "Extraction answer (reading test, phase 3)",
  "description": "One reading of one gold-set document: the survey fields matching needs (docs/reading-benchmark.md, section 1). 'not_stated' is always allowed and required when the text is silent. The model produces 'surveys'; R adds uri, backend, model and answered_at (x-meta-fields) before validation.",
  "x-schema-version": "0.1.0",
  "x-meta-fields": ["uri", "backend", "model", "answered_at"],
  "type": "object",
  "additionalProperties": false,
  "required": ["uri", "surveys", "backend", "model", "answered_at"],
  "properties": {
    "uri":         {"type": "string", "minLength": 1},
    "backend":     {"enum": ["claude_code", "ellmer"]},
    "model":       {"type": "string", "minLength": 1},
    "answered_at": {"type": "string", "format": "date-time"},
    "surveys": {
      "type": "array",
      "minItems": 1,
      "description": "One item per sampling survey whose own field work the document reports (a document may report several). If the document only cites someone else's survey, one item with what it states about that survey.",
      "items": {"$ref": "#/$defs/survey"}
    }
  },
  "$defs": {
    "page": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Page number as given in the record's [page N] markers; null when the value is not_stated."
    },
    "text_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "page"],
      "properties": {
        "value": {"type": "string", "minLength": 1, "maxLength": 300},
        "page":  {"$ref": "#/$defs/page"}
      }
    },
    "survey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "period", "institution", "region", "taxon_scope",
                   "data_statement", "stations"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 120,
                  "description": "Short name of the survey in the document's own words."},
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "page"],
          "properties": {
            "value": {"type": "string",
                      "pattern": "^(not_stated|[0-9]{4}(-[0-9]{4})?(;[0-9]{4}(-[0-9]{4})?)*)$",
                      "description": "Years sampled: 2020, 2015-2019 or 2015;2017;2019."},
            "page": {"$ref": "#/$defs/page"}
          }
        },
        "institution": {"$ref": "#/$defs/text_field",
                        "description": "Who did the field work (not the client), as printed; several separated by ';'."},
        "region": {"$ref": "#/$defs/text_field",
                   "description": "Place names of the study area as printed, separated by ';'."},
        "taxon_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "page"],
          "properties": {
            "value": {"enum": ["yes", "no", "not_stated"],
                      "description": "Were Ephemeroptera, Plecoptera or Trichoptera sampled and identified?"},
            "page": {"$ref": "#/$defs/page"}
          }
        },
        "data_statement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "quote", "page"],
          "properties": {
            "value": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["appendix_species_list", "vannmiljo", "gbif", "other_database",
                                 "on_request", "not_stated"]}
            },
            "quote": {"type": "string", "maxLength": 200,
                      "description": "Short verbatim phrase supporting the value, or not_stated."},
            "page": {"$ref": "#/$defs/page"}
          }
        },
        "stations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "items"],
          "properties": {
            "status": {"enum": ["given", "not_stated"]},
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["station", "waterbody", "x", "y", "crs_as_printed",
                             "vannlokalitetkode", "page"],
                "properties": {
                  "station":           {"type": "string", "minLength": 1},
                  "waterbody":         {"type": "string", "minLength": 1},
                  "x":                 {"type": "string", "minLength": 1,
                                        "description": "Easting or longitude exactly as printed, or not_stated."},
                  "y":                 {"type": "string", "minLength": 1,
                                        "description": "Northing or latitude exactly as printed, or not_stated."},
                  "crs_as_printed":    {"type": "string", "minLength": 1,
                                        "description": "Coordinate system as the document names it, or not_stated."},
                  "vannlokalitetkode": {"type": "string", "pattern": "^(not_stated|[0-9]{3}-[0-9]+-[A-Za-z])$"},
                  "page":              {"$ref": "#/$defs/page"}
                }
              }
            }
          }
        }
      }
    }
  }
}
